[Unit]
Description=ReceiptPi: finish or undo an update that was interrupted
Documentation=https://github.com/HostisHumani/ReceiptPi
# Only after an interrupted update; the updater keeps this file while it
# changes the system.
ConditionPathExists=/var/lib/receiptpi-update/journal.json
After=local-fs.target
Before=receiptpi.service receiptpi-firstboot.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -E -s /opt/receiptpi/deploy/update/updater.py recover
RuntimeDirectory=receiptpi-update
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt /etc/systemd/system /etc/udev/rules.d /etc/receiptpi
ReadWritePaths=-/var/lib/receiptpi /var/lib/receiptpi-update
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER

[Install]
WantedBy=multi-user.target
